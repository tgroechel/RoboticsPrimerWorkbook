  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"sonar_link\">\r\n  <sensor name=\"sonar\" type=\"ray\">\r\n   
    <always_on>true</always_on>\r\n    <update_rate>10</update_rate>\r\n    <pose>0
    0 0 0 0 0</pose>\r\n    <visualize>false</visualize>\r\n    <ray>\r\n      <scan>\r\n       
    <horizontal>\r\n          <samples>3</samples>\r\n          <resolution>1</resolution>\r\n         
    <min_angle>-0.349065850399</min_angle>\r\n          <max_angle> 0.349065850399</max_angle>\r\n       
    </horizontal>\r\n        <vertical>\r\n          <samples>3</samples>\r\n         
    <resolution>1</resolution>\r\n          <min_angle>-0.349065850399</min_angle>\r\n         
    <max_angle> 0.349065850399</max_angle>\r\n        </vertical>\r\n      </scan>\r\n     
    <range>\r\n        <min>0.03</min>\r\n        <max>3.0</max>\r\n        <resolution>0.01</resolution>\r\n     
    </range>\r\n    </ray>\r\n    <plugin filename=\"libhector_gazebo_ros_sonar.so\"
    name=\"gazebo_ros_sonar_controller\">\r\n      <gaussianNoise>0.005</gaussianNoise>\r\n     
    <topicName>sonar_height</topicName>\r\n      <frameId>sonar_link</frameId>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
